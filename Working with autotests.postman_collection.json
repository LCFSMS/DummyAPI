      "name": "GetPostList",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "\tpm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Status code is OK \", function () {\r",
              "\tpm.response.to.have.status(\"OK\");\r",
              "});\r",
              "pm.test(\"Response time is less than 1000ms\", function () {\r",
              "\tpm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "pm.collectionVariables.set(\"ownerPostId\", jsonData.data[0].owner.id);\r",
              "\r",
              "pm.test(\"checking data is Array\", function () {\r",
              "    pm.expect(jsonData.data).to.be.a('array');\r",
              "});\r",
              "pm.test(\"checking data[0] is string\", function () {\r",
              "    pm.expect(jsonData.data[0].id).to.be.a('string');\r",
              "});\r",
              "pm.test(\"checking data[0] link is undefined\", function () {\r",
              "    pm.expect(jsonData.data[0].link).to.be.a('undefined');\r",
              "});\r",
              "\r",
              "pm.test(\"checking data[0] is string\", function () {\r",
              "    pm.expect(jsonData.data[19].id).to.be.a('string');\r",
              "});\r",
              "\r",
              "pm.test(\"checking data[20] is undefined\", function () {\r",
              "    pm.expect(jsonData.data[20]).to.be.a('undefined');\r",
              "});\r",
              "\r",
              "pm.test(\"checking data limit is 20\", function () {\r",
              "    pm.expect(jsonData.limit).to.eql(20);\r",
              "});\r",
              "\r",
              "pm.test(\"checking data page is 0\", function () {\r",
              "    pm.expect(jsonData.page).to.eql(0);\r",
              "});\r",
              "\r",
              "pm.test(\"checking data total is number\", function () {\r",
              "    pm.expect(jsonData.total).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "\r",
              "\r",
              ""
